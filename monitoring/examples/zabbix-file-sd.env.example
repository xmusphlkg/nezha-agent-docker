# Install as /etc/prometheus/zabbix-file-sd.env with mode 0600.
# If omitted, generate-zabbix-blackbox-file-sd.py falls back to
# /etc/zabbix/zabbix_server.conf where possible.

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=zabbix
MYSQL_USER=zabbix
MYSQL_PASSWORD=replace-with-zabbix-db-password
