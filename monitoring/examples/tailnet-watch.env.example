# Copy to /etc/ctm-monitoring/tailnet-watch.env.
# The watcher detects new Headscale/Tailscale devices by comparing
# headscale_nodes_info from Prometheus with a local state file.

TAILNET_WATCH_PROMETHEUS_URL=http://127.0.0.1:9090
TAILNET_WATCH_RELAY_URL=http://127.0.0.1:8066/alertmanager
TAILNET_WATCH_STATE_FILE=/var/lib/ctm-monitoring/tailnet-watch.json

# First run creates a baseline and does not notify by default.
TAILNET_WATCH_BASELINE_NOTIFY=false
TAILNET_WATCH_TIMEOUT_SEC=8
TAILNET_WATCH_NODE_QUERY=headscale_nodes_info
TAILNET_WATCH_PREAUTH_INFO_QUERY=headscale_preauthkeys_info
TAILNET_WATCH_PREAUTH_CREATED_QUERY=headscale_preauthkeys_created_timestamp
TAILNET_WATCH_PREAUTH_EXPIRATION_QUERY=headscale_preauthkeys_expiration_timestamp
