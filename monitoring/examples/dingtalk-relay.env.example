# Copy to /etc/ctm-monitoring/dingtalk-relay.env and keep mode 0600.
DINGTALK_LISTEN_HOST=127.0.0.1
DINGTALK_LISTEN_PORT=8066

# Keep this secret out of git.
# Example: https://oapi.dingtalk.com/robot/send?access_token=...
DINGTALK_WEBHOOK=

# Optional when DingTalk robot signature validation is enabled.
DINGTALK_SECRET=

# Include the robot keyword in every message when keyword validation is enabled.
DINGTALK_KEYWORD=CTM

# Optional paging behavior.
DINGTALK_MAX_ALERTS=8
DINGTALK_TIMEOUT_SEC=8
DINGTALK_AT_MOBILES=
DINGTALK_AT_ALL=false
