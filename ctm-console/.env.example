# Copy to .env and keep mode 0600.
CTM_CONSOLE_BIND=0.0.0.0
CTM_CONSOLE_PORT=8088
PUBLIC_BASE_URL=http://127.0.0.1:8088
VITE_BASE_PATH=/
VITE_API_PROXY=http://127.0.0.1:8088
VITE_NAV_SCAN_CIDRS_DEFAULT=192.168.3.0/24
VITE_NAV_SCAN_CIDRS_PLACEHOLDER=192.168.3.0/24, 192.168.10.0/24

# Required for the built-in navigation/login system.
CTM_ADMIN_USERNAME=admin
CTM_ADMIN_PASSWORD=replace-with-initial-admin-password
CTM_SESSION_SECRET=replace-with-long-random-session-secret
CTM_SESSION_TTL_HOURS=12

# Manual navigation discovery defaults.
NAV_SCAN_CIDRS=192.168.3.0/24
NAV_SCAN_PORTS=80,443,3000,3001,5000,5001,5173,5601,8000,8006,8080,8081,8088,8090,8443,8888,9000,9001,9090,9091,9093,9200,9443

ZABBIX_URL=http://127.0.0.1:8080/api_jsonrpc.php
ZABBIX_TOKEN=replace-with-zabbix-api-token
PROMETHEUS_URL=http://127.0.0.1:9090
GRAFANA_BASE_URL=http://192.168.30.91:30037
GRAFANA_ORG_ID=1
GRAFANA_DEFAULT_FROM=now-6h
GRAFANA_DEFAULT_TO=now
GRAFANA_TIMEZONE=browser
GRAFANA_REFRESH=30s

# Optional Wazuh summary from the CTM Wazuh Prometheus exporter.
CTM_WAZUH_ENABLED=false
CTM_WAZUH_MODULES=agents,alerts,ssh,fim
CTM_WAZUH_WINDOW=24h
CTM_WAZUH_TOP_LIMIT=8
CTM_WAZUH_RECENT_LIMIT=12

# Optional single PVE data source.
PVE_HOST=
PVE_PORT=8006
PVE_NAME=PVE
PVE_TOKEN_ID=
PVE_TOKEN_SECRET=
PVE_VERIFY_SSL=false

# Optional multiple PVE data sources. When set, this takes precedence over PVE_HOST.
# PVE_SERVERS_JSON=[{"name":"pve-a","host":"192.168.3.10","port":8006,"token_id":"user@pam!monitor","token_secret":"secret","verify_ssl":false}]

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=dashboard
MYSQL_PASSWORD=replace-with-mysql-password
MYSQL_DATABASE=dashboard
MYSQL_TABLE=ctm_console_cache

SNAPSHOT_INTERVAL_SEC=30
ALERTS_INTERVAL_SEC=60
SERIES_CACHE_TTL_SEC=300
